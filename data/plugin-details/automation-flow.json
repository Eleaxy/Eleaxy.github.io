    {
      "id": "property-package-flow",
      "title": {
        "en": "Property Package data flow",
        "zh": "属性包数据流"
      },
      "items": [
        {
          "en": "Capture package properties",
          "zh": "捕捉属性包属性"
        },
        {
          "en": "Apply package properties",
          "zh": "应用属性包属性"
        },
        {
          "en": "Continue through the linear flow with pre-check, dry-run, and log support",
          "zh": "沿线性流程继续执行，并支持预检查、试运行和日志"
        }
      ],
      "source_kind": "repository_verified",
      "source_ref": "readme"
    },
    {
      "id": "quick-validation",
      "title": {
        "en": "Quick Validation Flow",
        "zh": "快速验证流程"
      },
      "steps": [
        {
          "step": 1,
          "label": {
            "en": "Create an `Automation Flow` tree in the Node Editor.",
            "zh": "在节点编辑器中新建 `Automation Flow` 树。"
          }
        },
        {
          "step": 2,
          "label": {
            "en": "Add and connect: `Start`; `Modifier Property Data` for capture; `Modifier Property Data` for target; `Create Property Package`; `Store Property Package`; `Create Property Package`; `Apply Object Properties`; `End`.",
            "zh": "添加并连接：`Start`；用于捕捉的 `Modifier Property Data`；用于目标的 `Modifier Property Data`；`Create Property Package`；`Store Property Package`；`Create Property Package`；`Apply Object Properties`；`End`。"
          }
        },
        {
          "step": 3,
          "label": {
            "en": "Set the capture property data fields to `Current`, then connect its `Property Assignment` output plus `Object List` into the first `Create Property Package`.",
            "zh": "将捕捉属性数据字段设为 `Current`，再把其 `Property Assignment` 输出与 `Object List` 接到第一个 `Create Property Package`。"
          }
        },
        {
          "step": 4,
          "label": {
            "en": "Set the target property data fields to `Value`, then connect its `Property Assignment` output plus `Object List` into the second `Create Property Package`.",
            "zh": "将目标属性数据字段设为 `Value`，再把其 `Property Assignment` 输出与 `Object List` 接到第二个 `Create Property Package`。"
          }
        },
        {
          "step": 5,
          "label": {
            "en": "Connect the captured package into `Store Property Package`, then connect the target package into `Apply Object Properties`. Connect the target property data `Property Definition` output into `Apply Object Properties`.",
            "zh": "将捕捉到的包接入 `Store Property Package`，再将目标包接入 `Apply Object Properties`；把目标属性数据的 `Property Definition` 输出接入 `Apply Object Properties`。"
          }
        },
        {
          "step": 6,
          "label": {
            "en": "Run the flow from the sidebar panel.",
            "zh": "从侧栏面板运行流程。"
          }
        }
      ],
      "source_kind": "repository_verified",
      "source_ref": "readme"
    },
