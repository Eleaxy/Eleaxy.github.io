    "Split Points": {
      "zh": "拆分点",
      "d": "Split Points 节点用于将选中的点从原有拓扑中分离，使其不再与相邻几何共享同一顶点。该操作会在选中的位置创建独立的点，从而断开连接关系，但保留几何的整体形状。常用于生成裂缝、硬边、分离网格片段或为后续变形、UV、法线处理做准备。",
      "notes": "",
      "example": "",
      "exampleImg": "Desktop/Desktop Screenshot 2026.07.15 - 17.44.24.46.png",
      "paramDescs": {
        "i": {
          "0": "输入需要进行点分离操作的几何数据，包括网格及其属性。",
          "1": "指定需要分离的点。为 True 的点会与相邻拓扑断开并复制为独立顶点，False 的点保持原状。"
        },
        "o": {
          "0": "输出完成点分离后的几何数据，包含更新后的拓扑结构及保留的几何属性。"
        }
      },
      "enName": "Split Points",
      "createdVersion": "v1.0.1",
      "lastModifiedVersion": "v1.0.1"
    },
    "Find All Cells": {
      "zh": "寻找封闭单元",
      "d": "Find All Cells 节点用于从输入的边网络中检测并枚举所有满足条件的封闭单元（Cell），将每个封闭区域转换为一条封闭曲线",
      "notes": "峰峰居士友情赞助~\n\n输入边应尽可能形成无歧义的闭合拓扑，否则可能无法生成完整单元或产生重复结果。需要指定每个点的Normal，否则部分单元可能因方向判断而被忽略。N-gons 用于限制允许生成的多边形边数，只会生成多边形边数小于N-gons的Cell。该节点通常用于平面边网络，不适用于复杂三维自交结构。",
      "example": "将二维 Voronoi 边线连接到 Edges 输入，设置 Normal 为 (0,0,1)，即可自动重建所有 Voronoi 面。支持3D，但需要合理设置点Normal，并保证输入边的闭合拓扑合理",
      "exampleImg": "Desktop/Desktop Screenshot 2026.07.16 - 16.59.14.29.png",
      "createdVersion": "v1.0.1",
      "lastModifiedVersion": "v1.0.1",
      "enName": "Find All Cells",
      "paramDescs": {
        "i": {
          "0": "输入用于构建单元的边几何数据。节点会分析这些边之间的连接关系，并寻找能够组成封闭区域的所有边界。",
          "1": "指定搜索所依据的参考法线方向，用于确定平面方向及面朝向，帮助正确识别封闭区域。",
          "2": "指定允许生成的多边形边数或相关限制条件，用于过滤符合要求的封闭单元。"
        },
        "o": {
          "0": "输出检测得到的所有封闭单元几何，每个 Cell 表示输入边网络中的一个有效封闭区域，可继续用于网格生成或后续几何节点处理。"
        }
      }
    },
    "2D Medial Axis": {
      "zh": "二维中轴线",
      "d": "2D Medial Axis 节点用于从二维网格区域计算其几何中轴线（Medial Axis），生成表示对象骨架的曲线。生成的中轴线能够反映形状的整体拓扑结构",
      "notes": "输入网格应为二维平面网格。提高 Precision 可以获得更精确的中轴线，但会增加计算时间。Smooth Iterations 可减少锯齿和噪声，而 Collinear Threshold 会影响近乎共线点的合并与简化效果。",
      "example": "将一个二维文字或平面轮廓网格连接到 Mesh 输入，适当提高 Precision 并进行数次平滑，即可生成可用于道路网络、植物枝干或程序化骨架动画的中心曲线。",
      "exampleImg": "Desktop/Desktop Screenshot 2026.07.16 - 17.05.43.19.png",
      "createdVersion": "v1.0.1",
      "lastModifiedVersion": "v1.0.1",
      "enName": "2D Medial Axis"
    },
    "2D Straight Skeleton": {
      "zh": "二维直骨架",
      "d": "2D Straight Skeleton 节点用于从二维网格或平面多边形计算其直骨架（Straight Skeleton），并输出对应的曲线结构。直骨架由边界沿法向匀速向内偏移时形成，与中轴线不同，它完全由线段组成并保留原始边界的拓扑特征。该节点适用于屋顶生成、轮廓内缩、道路网络及程序化建筑建模等应用。",
      "notes": "输入几何应为封闭且位于同一平面上的网格或多边形，开放边界或非流形拓扑可能导致计算失败。Precision 会影响骨架计算精度和稳定性，较高的值通常会增加计算时间。Smooth Iterations 可对输出曲线进行平滑处理，而 Collinear Threshold 用于合并近乎共线的顶点，减少冗余折线。",
      "example": "将建筑平面轮廓连接到 Mesh 输入，设置适当的 Precision 后计算直骨架，再利用输出 Curve 作为屋脊线生成程序化屋顶或进行轮廓内缩建模。",
      "exampleImg": "Desktop/Desktop Screenshot 2026.07.16 - 17.10.22.20.png",
      "createdVersion": "v1.0.1",
      "lastModifiedVersion": "v1.0.1",
      "enName": "2D Straight Skeleton"
    },
